{
  "rules": {
    "antelopejs/no-comments": 33,
    "anti-slop/no-chained-type-assertions": 5,
    "anti-slop/no-runtime-typeof": 2,
    "anti-slop/no-unknown-parameters": 4,
    "anti-slop/no-unknown-returns": 2,
    "anti-slop/no-unsafe-dictionary-type": 1,
    "anti-slop/require-safety-comment-for-type-assertion": 70,
    "eslint/max-lines-per-function": 4,
    "eslint/max-params": 4,
    "typescript/restrict-template-expressions": 1,
    "typescript/unbound-method": 21
  },
  "oversizeFiles": {
    "src/index.ts": 43261,
    "src/tests/index.test.ts": 38138
  }
}
