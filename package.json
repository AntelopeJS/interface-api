{
  "name": "@antelopejs/interface-api",
  "version": "0.0.16",
  "description": "AntelopeJS interface for HTTP and WebSocket APIs: decorator-based controllers, routes and parameter injection",
  "keywords": [
    "antelopejs",
    "api",
    "decorators",
    "http",
    "interface",
    "rest",
    "websocket"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/api",
  "bugs": {
    "url": "https://github.com/AntelopeJS/interface-api/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/interface-api.git"
  },
  "files": [
    "dist",
    "docs",
    "skills"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/tooling-configs": "^0.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/sinon": "^17.0.4",
    "@types/ws": "^8.18.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^20.0.0",
    "typescript": "^5.9.3",
    "ws": "^8.20.0"
  },
  "peerDependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "test": "src/antelope.test.ts",
    "skills": [
      "./skills"
    ]
  }
}
